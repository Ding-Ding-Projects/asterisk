{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "../..",
    "outDir": "../../dist-electron",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "main.ts",
    "preload.ts",
    "squirrel-events.ts",
    "updater-runtime.ts",
    "../../shared/**/*.ts",
    "../../control-plane/**/*.ts",
    "../../server/**/*.ts",
    "../renderer/src/display-name.ts"
  ]
}
