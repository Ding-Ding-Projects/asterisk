    },
    {
      "path": "design/Asterisk Console M3.dc.html",
      "mode": "generated-helper-route",
      "literalStatus": "localized-runtime-helper",
      "templateStatus": "template-key-required"
    },
    {
      "path": "console/app/renderer/src/generated/console.tsx",
      "mode": "generated-helper-route",
      "literalStatus": "localized-runtime-helper",
      "templateStatus": "template-key-required"
    }
  ],
  "helpers": [
    {
      "key": "localizedToast",
      "path": "console/app/renderer/src/App.tsx",
      "fallback": "untranslated-yue-track-plain-english"
    },
    {
      "key": "localizedFire",
      "path": "console/app/renderer/src/App.tsx",
      "fallback": "untranslated-yue-track-plain-english"
    }
  ],
  "templates": [
