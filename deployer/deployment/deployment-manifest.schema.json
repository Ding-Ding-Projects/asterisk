{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "image", "sourceCommit", "version", "projectName", "adminPort", "networkMode", "mountProfile", "mountInventory", "volumeSchemaVersion", "target", "targetHost", "targetUser", "targetSshPort", "inventoryPath", "preflightEvidencePath", "preflightEvidenceSha256", "preflightExpiresAt", "provenanceSha256", "sourceTreeSha256", "dockerfileSha256", "consoleLockSha256", "inputManifestSha256", "aptSbomSha256", "ubuntuSnapshot", "runtimeBaseImage", "nodeBuildBaseImage", "snapshotKeyId"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "image": { "type": "string", "pattern": "@sha256:[0-9a-f]{64}$" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "version": { "type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z._+-]{0,63}$" },
    "projectName": { "const": "ding-pbx-control-plane" },
    "adminPort": { "const": 8088 },
    "networkMode": { "const": "admin-only" },
    "mountProfile": { "const": "five-volumes-plus-run-tmpfs" },
    "mountInventory": { "const": ["ding-pbx-control-plane-data", "ding-pbx-control-plane-asterisk-etc", "ding-pbx-control-plane-asterisk-lib", "ding-pbx-control-plane-asterisk-log", "ding-pbx-control-plane-asterisk-spool", "/run/asterisk:tmpfs"] },
    "volumeSchemaVersion": { "const": 1 },
    "target": { "enum": ["local-docker", "approved-ssh"] },
    "targetHost": { "type": "string", "minLength": 1 },
    "targetUser": { "type": "string", "minLength": 1 },
    "targetSshPort": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "inventoryPath": { "type": "string", "minLength": 1 },
    "preflightEvidencePath": { "type": "string", "minLength": 1 },
    "preflightEvidenceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "preflightExpiresAt": { "type": "string", "format": "date-time" },
    "provenanceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    ,"sourceTreeSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    ,"dockerfileSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    ,"consoleLockSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    ,"inputManifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    ,"aptSbomSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    ,"ubuntuSnapshot": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z$" }
    ,"runtimeBaseImage": { "type": "string", "pattern": "@sha256:[0-9a-f]{64}$" }
    ,"nodeBuildBaseImage": { "type": "string", "pattern": "@sha256:[0-9a-f]{64}$" }
    ,"snapshotKeyId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,63}$" }
  },
  "additionalProperties": false
}
