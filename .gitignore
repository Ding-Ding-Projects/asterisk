# git ls-files --others --exclude-from=.git/info/exclude
# Lines that start with '#' are comments.
# For a project mostly in C, the following would be a good set of
# exclude patterns (uncomment them if you want to use them):
# *.[oa]
# *~

# See .gitignore in subdirectories for more ignored files

*~
*.[oadi]
*.gz
*.ii
*.oo
*.eo
*.so
*.exports
*.moduleinfo
*.makeopts
*.makedeps
.lastclean
/.pc
aclocal.m4
autom4te.cache
config.log
config.status
defaults.h
makeopts
makeopts.embed_rules
menuselect-tree
*.sha1
*.pyc
*.gcno
*.gcda
latex
doxygen.log
out/
*.orig
tests/CI/output
.develvars
.devcontainer/
.claude/
.clangd
.clang-format
.clang-tidy
compile_commands.json
.cache/

# Ding PBX Console generated dependencies and build outputs
/console/node_modules/
/console/dist/
/console/dist-electron/
/console/site/dist/
/console/tsconfig.tsbuildinfo
/console/resources/asterisk-wsl-rootfs.tar
/console/resources/asterisk-wsl-rootfs.json
/console/resources/forge/gh.exe

# Compiled output emitted beside sources. A stray typecheck with the wrong
# settings drops these into the source tree, where they shadow the real
# modules and get committed as though they were written by hand.
console/control-plane/*.js
console/control-plane/*.d.ts

# Built installer images. Multi-gigabyte artifacts are never committed; the release
# record carries their digest instead.
console/release/
